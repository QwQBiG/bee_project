# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenv
venv/
env/
ENV/
.venv/
.venv-py313/
.runtime/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 模型权重文件（过大，不建议提交）
*.pt
*.pth
*.onnx
*.bin

# 本地 Python 离线安装包（例如 1～3 GB 的 PyTorch wheel）
packages/*.whl
packages/*.zip
packages/get-pip.py

# 输出结果
output/
runtime_results/
runtime_environment.json
.runtime-bootstrap.lock

# Web 界面运行时数据（上传视频、标注视频、任务记录，勿提交）
app/uploads/
app/task_store.json
app/task_store.tmp

# 临时文件
tmp/
temp/
*.tmp

# Ultralytics 缓存
.ultralytics/

# 视频数据（过大，不提交）
data/**/*.mp4
data/**/*.avi
data/**/*.mov

# 系统文件
Thumbs.db
.DS_Store

# 日志
*.log
logs/

# OIST 第三方标注原始包（本地评测使用，不重新分发）
data/external/oist/annotations/*.tgz
data/external/oist/annotations/frame_annotations_30fps/
data/external/oist/annotations/frame_annotations_70fps/

# 官方原始视频的本地工作目录（可能包含大文件和本机绝对路径）
datasets/official_work/
datasets/official_pose/
